# Local environment-variable reference
#
# This file is documentation only. Next.js does not load `.local.env` automatically.
# To use these values at runtime, copy the required entries to `.env.local`.
# Keep real secrets out of version control.

# Runtime mode. Use `development` locally and `production` for production deployments.
NODE_ENV=development

# HTTP port used by server.js. Defaults to 3000 when omitted.
PORT=3000

# Canonical application URL. server.js sets http://localhost:<PORT> when omitted.
NEXTAUTH_URL=http://localhost:3000

# Secret used by NextAuth to sign JWTs. Required outside local development.
# Generate a unique value, for example: `openssl rand -base64 32`
NEXTAUTH_SECRET=replace-with-a-unique-secret

# Database configuration is currently not environment-based.
# Prisma uses the SQLite database configured in prisma/schema.prisma:
# prisma/dev.db
